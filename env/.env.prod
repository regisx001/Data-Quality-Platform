# ===================================================================
# dQul Platform - Production / Docker Cluster Environment (.env.prod)
# Standalone Spark Cluster (spark://spark-master:7077) & Containerized Stack
# ===================================================================

# Database Settings (Docker Network Service: postgres:5432)
DQUL_DATABASE_URL=jdbc:postgresql://postgres:5432/dqul
DQUL_DATABASE_USERNAME=postgres
DQUL_DATABASE_PASSWORD=postgres

DQUL_LOGS_DATABASE_URL=jdbc:postgresql://postgres:5432/dqul_logs
DQUL_LOGS_DATABASE_USERNAME=postgres
DQUL_LOGS_DATABASE_PASSWORD=postgres

DATABASE_DRIVER=org.postgresql.Driver

# Kafka (Docker Network Service: kafka:9092)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9092
KAFKA_CONSUMER_GROUP_COMPUTE=dqul-compute-group
KAFKA_CONSUMER_GROUP_MAIN=dqul-main-group
KAFKA_CONSUMER_GROUP_LOGS=dqul-logs-group
KAFKA_TOPIC_PLATFORM_LOGS=platform-logs-topic
KAFKA_TOPIC_PLATFORM_LOGS_DLT=platform-logs-topic.DLT
KAFKA_TOPIC_PROFILE_REQUEST=dqul.dataset.profile.request
KAFKA_TOPIC_PROFILE_RESULT=dqul.dataset.profile.result
# Redis (Docker Network Service: redis:6379)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache TTL
CACHE_TTL=5m

# JWT Configuration
JWT_SECRET_KEY=TXlTdXBlclNlY3JldEtleUZvckpXVDIwMjZJc1RoaXNMb25nRW5vdWdoRm9ySFMyNTY=
JWT_EXPIRATION_TIME=86400000

# MinIO / S3 Object Storage (Docker Network Service: minio:9000)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_UI_PORT=21002
MINIO_API_PORT=21001
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=dqul-bucket

# Spark Standalone Cluster Mode Configuration
SPARK_ENABLED=true
SPARK_APP_NAME=dQul-compute-prod
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_HOST=dqul-compute
SPARK_DRIVER_BIND_ADDRESS=0.0.0.0
SPARK_WAREHOUSE_DIR=./spark-warehouse
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=2
SPARK_DEFAULT_PARALLELISM=4
SPARK_SHUFFLE_PARTITIONS=8
SPARK_LOG_LEVEL=WARN
SPARK_SERIALIZER=org.apache.spark.serializer.JavaSerializer
SPARK_UI_ENABLED=false
SPARK_UI_PORT=8080
SPARK_SQL_ADAPTIVE_ENABLED=true
SPARK_SQL_ANSI_ENABLED=true
SPARK_SQL_CASE_SENSITIVE=false
SPARK_SQL_SESSION_TIMEZONE=UTC
SPARK_SQL_BROADCAST_TIMEOUT=300

# Compose: Standalone Spark Cluster Ports
SPARK_MASTER_PORT=7077
SPARK_CLUSTER_UI_PORT=8080
