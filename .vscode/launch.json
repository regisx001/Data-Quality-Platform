{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "SparkProfilePostgres",
            "request": "launch",
            "mainClass": "com.regisx001.dQul.examples.SparkProfilePostgres",
            "projectName": "dQul",
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
        },
        {
            "type": "java",
            "name": "SparkValidationCmdApp",
            "request": "launch",
            "mainClass": "com.regisx001.dQul.SparkValidationCmdApp",
            "projectName": "dQul",
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "DQulApplication",
            "request": "launch",
            "mainClass": "com.regisx001.dQul.DQulApplication",
            "projectName": "dQul",
            "envFile": "${workspaceFolder}/.env",
            "vmArgs": "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
        }
    ]
}