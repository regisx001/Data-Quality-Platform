                        {
                            "key": "level",
                            "value": "ERROR",
                            "description": "Filter by log level."
                        },
                        {
                            "key": "serviceName",
                            "value": "dQul-validation",
                            "description": "Filter by exact service name (case-insensitive)."
                        },
                        {
                            "key": "category",
                            "value": "VALIDATION",
                            "description": "Filter by category (case-insensitive)."
                        },
                        {
                            "key": "traceId",
                            "value": "",
                            "description": "Filter by exact trace ID."
                        },
                        {
                            "key": "page",
                            "value": "0"
                        },
                        {
                            "key": "size",
                            "value": "10"
                        }
                    ]
                }
            }
        },
