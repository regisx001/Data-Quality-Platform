{
    "info": {
        "_postman_id": "f5d2c9e1-8a3b-4c6d-9e2f-1b7a6c3d5f8a",
        "name": "dQul-logs - Logs Microservice API",
        "description": "Postman collection for the dQul-logs microservice — a standalone Spring Boot service that ingests platform log events natively over Kafka, persists them to PostgreSQL, and exposes a read/ops-only REST API for querying, stats, and retention purge.\n\nBase URL: http://localhost:7001\n\nEndpoints are read/ops only (MVP) — there is no auth in the MVP surface, and no HTTP write path (ingestion is Kafka-only).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:7001",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Query Logs",
            "description": "Paginated query of log entries. Supports filters (search, level, serviceName, category, traceId) and pagination (page, size). Results are sorted by timestamp descending.\n\nPagination bounds: page >= 0, size in 1..100 (default 20). Invalid params return 400 with the ApiError envelope.",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/logs?level=INFO&size=20&page=0",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "logs"
                    ],
                    "query": [
                        {
                            "key": "level",
                            "value": "INFO",
                            "description": "Filter by log level (TRACE, DEBUG, INFO, WARN, ERROR, FATAL). Case-insensitive; 'ALL' or blank = no filter."
                        },
                        {
                            "key": "size",
                            "value": "20",
                            "description": "Entries per page (1..100)."
                        },
                        {
                            "key": "page",
                            "value": "0",
                            "description": "Zero-based page number (>= 0)."
                        }
                    ]
                },
                "description": "Returns a paginated envelope: content, page, size, totalElements, totalPages, first, last, hasNext, hasPrevious."
            },
            "response": [
                {
                    "name": "200 OK - paginated logs",
                    "originalRequest": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/logs?level=INFO&size=20&page=0",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "logs"
                            ],
                            "query": [
                                {
                                    "key": "level",
                                    "value": "INFO"
                                },
                                {
                                    "key": "size",
                                    "value": "20"
                                },
                                {
                                    "key": "page",
                                    "value": "0"
                                }
                            ]
                        }
                    },
                    "status": "OK",
                    "code": 200,
                    "_postman_previewlanguage": "json",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": "{\n  \"content\": [\n    {\n      \"id\": \"3fa85f64-5717-4562-b3fc-2c963f66afa6\",\n      \"traceId\": \"8f14e45f-ceea-4b7b-9e5b-4b6f9f0b8a1c\",\n      \"serviceName\": \"dQul-validation\",\n      \"logLevel\": \"INFO\",\n      \"category\": \"VALIDATION\",\n      \"message\": \"Validation completed for dataset 'sales': 1042 rows checked, 7 violations found\",\n      \"stackTrace\": null,\n      \"path\": \"/api/v1/datasets/123/validate\",\n      \"httpMethod\": \"POST\",\n      \"statusCode\": 200,\n      \"executionTimeMs\": 1840,\n      \"userId\": \"u-1042\",\n      \"userEmail\": \"engineer@example.com\",\n      \"metadata\": \"{\\\"dataset\\\":\\\"sales\\\",\\\"violations\\\":7}\",\n      \"timestamp\": \"2026-08-05T10:47:27.688Z\"\n    }\n  ],\n  \"page\": 0,\n  \"size\": 20,\n  \"totalElements\": 1,\n  \"totalPages\": 1,\n  \"first\": true,\n  \"last\": true,\n  \"hasNext\": false,\n  \"hasPrevious\": false\n}"
                }
            ]
        },
        {
            "name": "Query Logs - Full Filter Set",
            "description": "Query logs using every available filter at once, plus pagination.",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/logs?search=customer_id&level=ERROR&serviceName=dQul-validation&category=VALIDATION&traceId=&page=0&size=10",
