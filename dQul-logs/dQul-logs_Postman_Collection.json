        {
            "name": "Purge Logs",
            "description": "Delete log entries older than N days (1..365). Default is 30 days. This is destructive.",
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/logs/purge?days=30",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "logs",
                        "purge"
                    ],
                    "query": [
                        {
                            "key": "days",
                            "value": "30",
                            "description": "Retention window in days (1..365). Entries older than this are deleted."
                        }
                    ]
                },
                "description": "Returns a success envelope: { status: SUCCESS, message: ... }"
            },
            "response": [
