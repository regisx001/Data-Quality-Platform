        "name": "dQul-logs - Logs Microservice API",
        "description": "Postman collection for the dQul-logs microservice — a standalone Spring Boot service that ingests platform log events natively over Kafka, persists them to PostgreSQL, and exposes a read/ops-only REST API for querying, stats, and retention purge.\n\nBase URL: http://localhost:7001\n\nEndpoints are read/ops only (MVP) — there is no auth in the MVP surface, and no HTTP write path (ingestion is Kafka-only).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:7001",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Query Logs",
            "description": "Paginated query of log entries. Supports filters (search, level, serviceName, category, traceId) and pagination (page, size). Results are sorted by timestamp descending.\n\nPagination bounds: page >= 0, size in 1..100 (default 20). Invalid params return 400 with the ApiError envelope.",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/api/v1/logs?level=INFO&size=20&page=0",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "logs"
                    ],
                    "query": [
                        {
                            "key": "level",
                            "value": "INFO",
                            "description": "Filter by log level (TRACE, DEBUG, INFO, WARN, ERROR, FATAL). Case-insensitive; 'ALL' or blank = no filter."
                        },
                        {
                            "key": "size",
                            "value": "20",
                            "description": "Entries per page (1..100)."
                        },
                        {
                            "key": "page",
                            "value": "0",
                            "description": "Zero-based page number (>= 0)."
                        }
                    ]
                },
                "description": "Returns a paginated envelope: content, page, size, totalElements, totalPages, first, last, hasNext, hasPrevious."
            },
            "response": [
                {
                    "name": "200 OK - paginated logs",
                    "originalRequest": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/api/v1/logs?level=INFO&size=20&page=0",
